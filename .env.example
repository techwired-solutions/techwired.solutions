# Contact form delivery (optional).
# Without RESEND_API_KEY the contact form falls back to opening the visitor's
# mail client addressed to CONTACT_TO.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are sent.
CONTACT_TO=hello@techwiredsolutions.com.np

# Verified sender for your Resend domain. Until the domain is verified you can
# use "Techwired Solutions <onboarding@resend.dev>".
CONTACT_FROM=Techwired Solutions <onboarding@resend.dev>
